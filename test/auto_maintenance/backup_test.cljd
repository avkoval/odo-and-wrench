(ns auto-maintenance.backup-test
  (:require [cljd.test :refer [deftest is]]
            [auto-maintenance.domain.backup :as b]))

(def events
  [{:type :car/registered :car "forester" :vin "JF1SH5LS58G000000" :name "Subaru Forester" :year 2008
    :fuels ["petrol" "lpg"] :decoded {:make "Subaru"}}
   {:type :maintenance/performed :car "forester" :entry "M-0001" :at "2026-11-17" :km 129400 :items ["engine-oil"]
    :extra [] :parts [{:name "Oil 5W-30" :qty 4.5 :unit "l" :price "400.00" :sum "1800.00"}] :cost "1800.00"}
   {:type :settings/reminders-configured :notify_at "19:30" :days ["sat"] :soon_km 1500 :soon_days 45
    :stale_days 21 :enabled false}])

(deftest events-survive-the-round-trip
  (is (= events (b/jsonl->events (b/events->jsonl events)))))

(deftest stream-follows-from-the-event
  (is (= ["forester" "forester" "settings"] (map b/stream-of events))))

(deftest a-line-that-is-not-an-event
  (is (= "invalid" (try (b/jsonl->events "{\"type\": \"car/registered\"}\n{\"car\": 1}")
                     (catch cljd.core/ExceptionInfo e (:category (ex-data e)))))))
