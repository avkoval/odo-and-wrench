(ns auto-maintenance.domain.decide
  "Command handling: `state` is the fold of the stream's events (`evolve`), `decide` turns a command into events
  or rejects it with (ex-info msg {:category \"invalid\" | \"not-found\" | \"conflict\"}). Pure, no I/O."
  (:require [clojure.string :as str]
            [auto-maintenance.domain.views :as v]
            [auto-maintenance.domain.receipt :as receipt]))

;; ------------------------------------------------------------------ state

(def initial {:settings {:language "en"} :cars {} :plates {} :vins {} :items {} :readings {} :log {} :issues {} :entries {}
              :reminded #{}})

(defn- log-event
  "Every event of a car is also kept in its log, for rules that need a read model (current km)."
  [state {:keys [car] :as e}]
  (cond-> state car (update-in [:log car] (fnil conj []) e)))

(defn- evolve-default [state _] state)

(defn- evolve-car-registered [state {:keys [car plate vin] :as e}]
  (cond-> (assoc-in state [:cars car] e)
    plate (assoc-in [:plates plate] car)
    vin (assoc-in [:vins vin] car)))

(defn- evolve-schedule-item-defined [state {:keys [car item] :as e}]
  (assoc-in state [:items [car item]] (assoc e :active true)))

(def interval-keys [:every_km :every_months :soon_km :soon_days])

(defn- evolve-schedule-item-changed [state {:keys [car item] :as e}]
  ;; a change replaces all intervals: what the event leaves out is no longer set
  (update-in state [:items [car item]] #(merge (apply dissoc % interval-keys) (select-keys e interval-keys))))

(defn- evolve-schedule-item-retired [state {:keys [car item]}]
  (assoc-in state [:items [car item] :active] false))

(defn- evolve-odometer-recorded [state {:keys [reading] :as e}]
  (assoc-in state [:readings reading] e))

(defn- evolve-issue-reported [state {:keys [issue] :as e}]
  (assoc-in state [:issues issue] (assoc e :open true)))

(defn- evolve-issue-withdrawn [state {:keys [issue]}]
  (assoc-in state [:issues issue :open] false))

(defn- set-open [state issues open?]
  (reduce (fn [s i] (cond-> s (get-in s [:issues i]) (assoc-in [:issues i :open] open?))) state issues))

(defn- evolve-maintenance-performed [state {:keys [entry fixes] :as e}]
  (-> state (assoc-in [:entries entry] e) (set-open fixes false)))

(defn- evolve-maintenance-voided [state {:keys [entry]}]
  ;; voiding the visit reopens what it fixed (D14)
  (-> state
    (set-open (get-in state [:entries entry :fixes]) true)
    (assoc-in [:entries entry :voided] true)))

(defn- evolve-settings-language-chosen [state {:keys [language]}]
  (assoc-in state [:settings :language] language))

(defn- evolve-reminder-sent [state {:keys [car item level due_km due_at]}]
  (cond-> state item (update :reminded conj [car item level due_km due_at])))

(defn evolve
  "Applies one event to the state. Plain `case` dispatch (not a multimethod): hot reload updates function bodies
  but does not re-run top-level defmethod registrations."
  [state event]
  (case (:type event)
    :settings/language-chosen (evolve-settings-language-chosen state event)
    :default (evolve-default state event)
    :car/registered (evolve-car-registered state event)
    :schedule/item-defined (evolve-schedule-item-defined state event)
    :schedule/item-changed (evolve-schedule-item-changed state event)
    :schedule/item-retired (evolve-schedule-item-retired state event)
    :odometer/recorded (evolve-odometer-recorded state event)
    :issue/reported (evolve-issue-reported state event)
    :issue/withdrawn (evolve-issue-withdrawn state event)
    :maintenance/performed (evolve-maintenance-performed state event)
    :maintenance/voided (evolve-maintenance-voided state event)
    :reminder/sent (evolve-reminder-sent state event)
    state))

(defn state-of [events] (reduce (fn [s e] (evolve (log-event s e) e)) initial events))

;; ------------------------------------------------------------------ helpers

(defn reject [category msg] (throw (ex-info msg {:category category})))

(defn present [m ks] (into {} (filter (comp some? val)) (select-keys m ks)))

(def ^:private look-alikes
  ;; Cyrillic letters on Ukrainian plates that look like Latin ones
  [["А" "A"] ["В" "B"] ["Е" "E"] ["І" "I"] ["К" "K"] ["М" "M"] ["Н" "H"] ["О" "O"] ["Р" "P"] ["С" "C"]
   ["Т" "T"] ["Х" "X"]])

(defn normalize-plate [plate]
  (when plate
    (reduce (fn [s [cyr lat]] (str/replace s cyr lat))
      (-> plate str/upper-case (str/replace #"[\s-]" ""))
      look-alikes)))

(defn valid-vin? [vin]
  (and (string? vin) (some? (re-matches #"[A-HJ-NPR-Z0-9]{17}" vin))))

(defn positive-or-absent? [x] (or (nil? x) (and (int? x) (pos? x))))

(defn require-car
  "A car exists once its stream has events (normally starting with car/registered)."
  [state car]
  (when-not (or (get-in state [:cars car]) (seq (get-in state [:log car])))
    (reject "not-found" (str "unknown car " car))))

;; ------------------------------------------------------------------ commands

(defn- decide-car-register [state {:keys [car name vin plate] :as cmd}]
  (let [plate (normalize-plate plate)]
    (cond
      (str/blank? name) (reject "invalid" "name is blank")
      (not (valid-vin? vin)) (reject "invalid" "VIN must be 17 characters A-Z/0-9 without I, O, Q")
      (get-in state [:cars car]) (reject "conflict" (str "car " car " exists"))
      (get-in state [:vins vin]) (reject "conflict" (str "VIN " vin " belongs to another car"))
      (and plate (get-in state [:plates plate])) (reject "conflict" (str "plate " plate " belongs to another car")))
    [(merge {:type :car/registered}
       (present (assoc cmd :plate plate)
         [:car :vin :name :make :model :year :engine :fuels :plate :photo :decoded]))]))

(defn- decide-schedule-define-item [state {:keys [car item title every_km every_months soon_km soon_days] :as cmd}]
  (require-car state car)
  (cond
    (str/blank? title) (reject "invalid" "title is blank")
    (and (nil? every_km) (nil? every_months)) (reject "invalid" "an interval in km or months is required")
    (not (every? positive-or-absent? [every_km every_months soon_km soon_days]))
    (reject "invalid" "intervals must be positive whole numbers")
    (get-in state [:items [car item] :active]) (reject "conflict" (str item " is already in the schedule")))
  [(merge {:type :schedule/item-defined}
     (present cmd [:car :item :title :every_km :every_months :soon_km :soon_days]))])

(defn- decide-odometer-record [state {:keys [car km] :as cmd}]
  (require-car state car)
  (let [current (:km (v/mileage (get-in state [:log car]) nil))]
    (cond
      (not (and (int? km) (pos? km))) (reject "invalid" "km must be a positive whole number")
      (and current (< km current)) (reject "conflict" (str "the odometer does not go back: last " current " km"))))
  [(merge {:type :odometer/recorded}
     (present cmd [:car :reading :at :km :source :photo :recognized_km :confidence]))])

(defn- decide-odometer-correct [state {:keys [car reading km reason] :as cmd}]
  (cond
    (not= car (get-in state [:readings reading :car])) (reject "not-found" (str "unknown reading " reading))
    (str/blank? reason) (reject "invalid" "a correction needs a reason")
    (not (and (int? km) (pos? km))) (reject "invalid" "km must be a positive whole number"))
  [(merge {:type :odometer/corrected} (present cmd [:car :reading :km :reason]))])

(defn- decide-issue-report [state {:keys [car text] :as cmd}]
  (require-car state car)
  (when (str/blank? text) (reject "invalid" "describe what is broken"))
  [(merge {:type :issue/reported} (present (update cmd :text str/trim) [:car :issue :at :text :photo]))])

(defn- decide-issue-withdraw [state {:keys [car issue reason] :as cmd}]
  (let [{open :open owner :car} (get-in state [:issues issue])]
    (cond
      (not (and open (= owner car))) (reject "not-found" (str "no open issue " issue))
      (str/blank? reason) (reject "invalid" "say why the issue is withdrawn")))
  [(merge {:type :issue/withdrawn} (present cmd [:car :issue :reason]))])

(defn- require-active-item [state car item]
  (let [it (get-in state [:items [car item]])]
    (when-not (and (:active it) (= car (:car it)))
      (reject "not-found" (str item " is not in the schedule of " car)))
    it))

(defn- decide-schedule-change-item [state {:keys [car item every_km every_months soon_km soon_days] :as cmd}]
  (require-car state car)
  (let [it (require-active-item state car item)
        intervals (present cmd [:every_km :every_months :soon_km :soon_days])]
    (cond
      (and (nil? every_km) (nil? every_months)) (reject "invalid" "an interval in km or months is required")
      (not (every? positive-or-absent? [every_km every_months soon_km soon_days]))
      (reject "invalid" "intervals must be positive whole numbers"))
    (if (= intervals (present it [:every_km :every_months :soon_km :soon_days]))
      []
      [(merge {:type :schedule/item-changed} (present cmd [:car :item :every_km :every_months :soon_km :soon_days :reason]))])))

(defn- decide-schedule-apply-template [state {:keys [car template version items]}]
  ;; the command carries the items as the owner saw them (D8); all of them are checked before any is defined
  (require-car state car)
  (cond
    (or (str/blank? template) (empty? items)) (reject "invalid" "a template with items is required")
    (some #(or (str/blank? (:item %)) (str/blank? (:title %))) items) (reject "invalid" "every item needs an id and a title")
    (some #(and (nil? (:every_km %)) (nil? (:every_months %))) items)
    (reject "invalid" "every item needs an interval in km or months")
    (not-every? #(every? positive-or-absent? ((juxt :every_km :every_months :soon_km :soon_days) %)) items)
    (reject "invalid" "intervals must be positive whole numbers"))
  (vec (for [it items
             :when (not (get-in state [:items [car (:item it)] :active]))]
         (merge {:type :schedule/item-defined :car car}
           (present it [:item :title :every_km :every_months :soon_km :soon_days])
           (present {:template template :version version} [:template :version])))))

(defn- decide-schedule-retire-item [state {:keys [car item] :as cmd}]
  (require-car state car)
  (require-active-item state car item)
  [(merge {:type :schedule/item-retired} (present cmd [:car :item :reason]))])

(def languages
  "Languages with translations (D11); English is the default."
  #{"en" "uk"})

(defn- decide-settings-choose-language [state {:keys [language]}]
  (cond
    (not (languages language)) (reject "invalid" (str "no translations for " language))
    (= language (get-in state [:settings :language])) []
    :else [{:type :settings/language-chosen :language language}]))

(def weekdays #{"mon" "tue" "wed" "thu" "fri" "sat" "sun"})

(defn valid-time? [t]
  (when-let [[_ h m] (and (string? t) (re-matches #"(\d\d):(\d\d)" t))]
    (and (< (int/parse h) 24) (< (int/parse m) 60))))

(defn- decide-settings-configure-reminders [_state {:keys [notify_at days soon_km soon_days stale_days enabled] :as cmd}]
  (cond
    (not (valid-time? notify_at)) (reject "invalid" "time must be HH:MM")
    (or (empty? days) (not-every? weekdays days)) (reject "invalid" "pick at least one day")
    (not (every? #(and (int? %) (pos? %)) [soon_km soon_days stale_days]))
    (reject "invalid" "windows must be positive whole numbers")
    (not (boolean? enabled)) (reject "invalid" "enabled must be true or false"))
  [(merge {:type :settings/reminders-configured}
     (present cmd [:notify_at :days :soon_km :soon_days :stale_days :enabled]))])

(def cost-categories #{"service" "repair" "tyres" "other"})

(defn money? [x] (and (string? x) (some? (re-matches #"\d+(\.\d{1,2})?" x))))

(defn line-ok?
  "A receipt line whose sum is quantity × price, to the cent (D17)."
  [{:keys [qty price sum]}]
  (and (number? qty) (pos? qty) (money? price) (money? sum)
    (= (v/cents sum) (.round (* ^num qty (v/cents price))))))

(defn- decide-maintenance-log [state {:keys [car km items extra fixes cost category parts labor] :as cmd}]
  (require-car state car)
  (let [lines (concat parts labor)
        lines-total (when (seq lines) (reduce + (map (comp v/cents :sum) (filter line-ok? lines))))
        cost (or cost (some-> lines-total v/money))]
    (cond
      (not (and (int? km) (pos? km))) (reject "invalid" "km must be a positive whole number")
      (and (empty? items) (empty? (remove str/blank? extra)) (empty? fixes) (empty? lines))
      (reject "invalid" "nothing done: tick a job, describe the work, pick a fixed issue or add receipt lines")
      (not-every? #(get-in state [:items [car %] :active]) items)
      (reject "invalid" "a job that is not in this car's schedule")
      (not-every? #(let [{:keys [open] owner :car} (get-in state [:issues %])] (and open (= owner car))) fixes)
      (reject "invalid" "only open issues of this car can be fixed")
      (not-every? line-ok? lines)
      (reject "invalid" (str "a receipt line whose sum is not quantity × price: "
                          (:name (first (remove line-ok? lines)))))
      (and lines-total (not= lines-total (v/cents cost)))
      (reject "invalid" (str "the cost " cost " is not the sum of the lines " (v/money lines-total)))
      (and cost (not (cost-categories category))) (reject "invalid" "a cost needs a category: service, repair, tyres or other"))
    [(merge {:type :maintenance/performed}
       (present (cond-> (assoc cmd :cost cost) extra (update :extra #(vec (remove str/blank? %))))
         [:car :entry :at :km :items :extra :fixes :parts :labor :note :cost :currency :category :place :order_no
          :photos :source]))]))

(defn- decide-maintenance-import-receipt [state {:keys [car entry items fixes category photos] :as cmd}]
  (let [{:keys [at km place order_no currency parts labor total]} (receipt/parse (:receipt cmd))
        lines (concat parts labor)]
    (when (empty? lines) (reject "invalid" "the receipt has no lines"))
    (when (and (every? line-ok? lines) (not= (v/cents total) (reduce + (map (comp v/cents :sum) lines))))
      (reject "invalid" (str "the receipt total " total " is not the sum of its lines — check the transcription")))
    (decide-maintenance-log state
      (into {} (filter (comp some? val))
        {:car car :entry entry :at at :km km :items (or items []) :extra [] :fixes fixes
         :parts parts :labor labor :cost total :currency currency :category category :place place
         :order_no order_no :photos photos :source "receipt"}))))

(defn- decide-maintenance-void [state {:keys [car entry reason] :as cmd}]
  (let [e (get-in state [:entries entry])]
    (cond
      (not (and e (= car (:car e)) (not (:voided e)))) (reject "not-found" (str "no diary entry " entry))
      (str/blank? reason) (reject "invalid" "say why the entry is voided")))
  [(merge {:type :maintenance/voided} (present cmd [:car :entry :reason]))])

(defn- decide-reminder-send [state {:keys [car item level due_km due_at] :as cmd}]
  ;; one notification per item, level and due point (D9); odometer-stale reminders carry no item
  (require-car state car)
  (cond
    (and item (not (#{"soon" "overdue"} level))) (reject "invalid" "level is soon or overdue")
    (and item (contains? (:reminded state) [car item level due_km due_at])) []
    :else [(merge {:type :reminder/sent}
             (present cmd [:car :item :kind :level :due_km :due_at :last_at :at :text]))]))

(defn decide
  "Turns a command into events or rejects it; `case` dispatch for the same hot-reload reason as `evolve`."
  [state command]
  (case (:type command)
    :car/register (decide-car-register state command)
    :settings/choose-language (decide-settings-choose-language state command)
    :settings/configure-reminders (decide-settings-configure-reminders state command)
    :schedule/define-item (decide-schedule-define-item state command)
    :schedule/change-item (decide-schedule-change-item state command)
    :schedule/retire-item (decide-schedule-retire-item state command)
    :schedule/apply-template (decide-schedule-apply-template state command)
    :reminder/send (decide-reminder-send state command)
    :odometer/record (decide-odometer-record state command)
    :odometer/correct (decide-odometer-correct state command)
    :issue/report (decide-issue-report state command)
    :issue/withdraw (decide-issue-withdraw state command)
    :maintenance/log (decide-maintenance-log state command)
    :maintenance/import-receipt (decide-maintenance-import-receipt state command)
    :maintenance/void (decide-maintenance-void state command)
    (reject "invalid" (str "unknown command " (:type command)))))

(defn handle
  "Decide `command` against the events of its stream."
  [events command]
  (decide (state-of events) command))
