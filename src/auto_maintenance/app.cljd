(ns auto-maintenance.app
  "The running app: the event log in memory (`!events`, loaded from the store at start) and `execute!`, the only way
  a screen changes anything: decide the command against the log, append the new events, then publish them."
  (:require ["package:flutter/services.dart" :as svc]
            [auto-maintenance.domain.decide :as d]
            [auto-maintenance.domain.json :as json]
            [auto-maintenance.domain.dates :as dates]
            [auto-maintenance.domain.views :as v]
            [auto-maintenance.store :as store]
            [auto-maintenance.photos :as photos]
            [auto-maintenance.i18n :as i18n]
            [clojure.string :as str]))

(defonce !db (atom nil))
(defonce !events (atom []))
(defonce !catalogue (atom []))

(defn- load-catalogue
  "Schedule templates shipped with the app (D8): assets/templates/index.json lists the files."
  []
  (loop [files (json/read-str (await (.loadString svc/rootBundle "assets/templates/index.json"))) acc []]
    (if-some [f (first files)]
      (recur (rest files) (conj acc (json/read-str (await (.loadString svc/rootBundle (str "assets/templates/" f))))))
      acc)))

(defn stream-of [command]
  (if (= "settings" (namespace (:type command))) "settings" (:car command)))

(defn settings [events] (v/settings (filter #(= "settings" (namespace (:type %))) events) nil))

(defn- use-language! [] (reset! i18n/!language (:language (settings @!events))))

(defn start! []
  (let [db (await (store/open!))]
    (await (photos/start!))
    (await (i18n/load!))
    (reset! !catalogue (await (load-catalogue)))
    (reset! !db db)
    (reset! !events (await (store/load-all db)))
    (use-language!)))

(defn reload!
  "Reads the log again: the background reminder job (another isolate) may have appended reminder/sent events."
  []
  (when @!db
    (reset! !events (await (store/load-all @!db)))))

(defn execute!
  "Runs `command`; returns nil on success or {:category .. :message ..} when it is rejected."
  [command]
  (try
    (let [events (d/handle @!events command)]
      (when (seq events)
        (await (store/append! @!db (stream-of command) events))
        (swap! !events into events)
        (use-language!))
      nil)
    (catch cljd.core/ExceptionInfo e
      (assoc (ex-data e) :message (ex-message e)))))

;; ------------------------------------------------------------------ views for screens

(defn car-events [events car]
  (filter #(or (= car (:car %)) (= "settings" (namespace (:type %)))) events))

(defn garage [events] (v/garage events {:today (dates/today)}))

(defn car [events car] (some #(when (and (= :car/registered (:type %)) (= car (:car %))) %) events))

(defn due-list [events car] (v/due-list (car-events events car) {:today (dates/today)}))

(defn mileage [events car] (v/mileage (car-events events car) nil))

(defn open-issues [events car] (v/open-issues (car-events events car) {:heading (i18n/t :to-fix-heading)}))

(defn diary [events car] (v/diary (car-events events car) nil))

(defn costs [events car] (v/costs-by-year (car-events events car) nil))

(defn schedule [events car] (v/schedule (car-events events car)))

(defn template-suggestions [events car]
  (v/template-suggestions (car-events events car) {:catalogue @!catalogue :language @i18n/!language}))

(defn template [id] (some #(when (= id (:template %)) %) @!catalogue))

(defn slug
  "An id from a name (\"Subaru Forester\" -> subaru-forester), unique among `taken`."
  [s taken]
  (let [base (-> s str/lower-case str/trim (str/replace #"[^a-z0-9]+" "-") (str/replace #"^-|-$" ""))
        base (if (str/blank? base) "x" base)]
    (first (remove (set taken) (cons base (map #(str base "-" %) (range 2 1000)))))))

(defn next-id
  "Next id of a kind (\"O\" readings, \"M\" diary entries, \"I\" issues): O-0001, O-0002 …, never reused."
  [events k prefix]
  (let [used (keep #(when-let [id (get % k)] (when (str/starts-with? id (str prefix "-")) (int/parse (subs id 2))))
               events)]
    (str prefix "-" (.padLeft (str (inc (reduce max 0 used))) 4 "0"))))
