(ns auto-maintenance.slices
  "Registry of implemented slices of model/event-model.yaml, keyed by slice id.

  A state-change or translation slice registers {:decide (fn [given-events command] -> [events])}; a rejection
  throws (ex-info msg {:category \"invalid\"}) with the model's then_error category. A state-view or automation
  slice registers {:project (fn [events params] -> read-model)}, where params holds :today when the scenario names
  one. Events and commands are maps with keyword keys and a keyword :type (:car/registered); other values stay
  as in the model (strings, numbers). The model check (test/auto_maintenance/model_test.cljd) runs every scenario
  of every registered slice and lists the slices not implemented yet."
  (:require ["dart:io" :as io]
            [auto-maintenance.domain.decide :as d]
            [auto-maintenance.domain.json :as json]
            [auto-maintenance.domain.views :as v]))

(defn catalogue-from-disk
  "The template catalogue (D8) as the app ships it: assets/templates/index.json lists the template files. The app
  reads the same files from its assets; the model check reads them from the project folder."
  []
  (vec (for [file (json/read-str (.readAsStringSync (io/File "assets/templates/index.json")))]
         (json/read-str (.readAsStringSync (io/File (str "assets/templates/" file)))))))

(def registry
  {"register-car" {:decide d/handle}
   "garage" {:project v/garage}
   "car-by-plate" {:project v/car-by-plate}
   "define-schedule-item" {:decide d/handle}
   "change-schedule-item" {:decide d/handle}
   "retire-schedule-item" {:decide d/handle}
   "record-odometer" {:decide d/handle}
   "correct-odometer" {:decide d/handle}
   "mileage" {:project v/mileage}
   "log-maintenance" {:decide d/handle}
   "import-receipt" {:decide d/handle}
   "void-maintenance" {:decide d/handle}
   "diary" {:project v/diary}
   "costs-by-year" {:project v/costs-by-year}
   "report-issue" {:decide d/handle}
   "withdraw-issue" {:decide d/handle}
   "open-issues" {:project v/open-issues}
   "settings" {:project v/settings}
   "choose-language" {:decide d/handle}
   "configure-reminders" {:decide d/handle}
   "due-list" {:project v/due-list}
   "template-suggestions" {:project (fn [events params]
                                      (v/template-suggestions events (assoc params :catalogue (catalogue-from-disk))))}
   "import-schedule-template" {:decide d/handle}
   "apply-schedule-template" {:decide d/handle}
   "reminders-to-send" {:project v/reminders-to-send}
   "send-reminder" {:decide d/handle}})
