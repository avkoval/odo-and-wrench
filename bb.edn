;; Project tasks. Every task runs with the project's pinned Flutter first on PATH:
;; ClojureDart hangs with Flutter 3.50 (https://github.com/tensegritics/ClojureDart/issues/389),
;; so this project uses Flutter 3.47.9 from ~/sdk until that is fixed. `bb tasks` lists them.
{:min-bb-version "1.3.0"
 :tasks
 {:requires ([clojure.string :as str] [clojure.java.io :as io] [babashka.process :as p])
  :init
  (do
    (def home (System/getProperty "user.home"))
    (def flutter-bin (str home "/sdk/flutter-3.47.9/bin"))
    (def android-home (str home "/Android/Sdk"))
    (def adb (str android-home "/platform-tools/adb")) ; full path: bb resolves programs on its own PATH
    ;; Release signing key (outside the repo; the same key is in the GitHub secrets for CI): KEY=VALUE lines
    ;; ANDROID_KEYSTORE_PATH, ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS, ANDROID_KEY_PASSWORD. Without the file,
    ;; release builds are signed with the debug key.
    (def signing-env
      (let [f (io/file home ".android/odo-and-wrench-release.properties")]
        (if (.exists f)
          (into {} (for [line (str/split-lines (slurp f)) :let [[k v] (str/split line (re-pattern "=") 2)] :when v] [k v]))
          {})))
    (def env (merge {"PATH" (str flutter-bin ":" android-home "/platform-tools:" (System/getenv "PATH"))
                     "ANDROID_HOME" android-home}
                    signing-env))
    (defn sh [& args] (apply shell {:extra-env env} args))
    (defn repl-port
      "Port of the live REPL of `bb dev`: REPL.lock holds \"<port> <pid>\"; nil when absent or its process is gone."
      []
      (let [f (java.io.File. "REPL.lock")]
        (when (.exists f)
          (let [[port pid] (str/split (str/trim (slurp f)) (re-pattern " +"))]
            (when (some-> pid parse-long java.lang.ProcessHandle/of (.orElse nil) .isAlive)
              port))))))

  doctor {:doc "flutter doctor with the pinned Flutter"
          :task (sh "flutter doctor")}

  devices {:doc "Connected devices (phone over USB / wireless adb, linux desktop)"
           :task (sh "flutter devices")}

  compile {:doc "Compile ClojureDart sources to Dart (lib/cljd-out)"
           :task (sh "clojure -M:cljd compile")}

  dev {:doc "Watch, hot reload and socket REPL on a device: bb dev [-d <device-id>] (default: ask). Keys (r, R, q)
             need Enter. Tracks the REPL's state in target/repl-state for bb repl-eval."
       :task (let [proc (p/process (into ["clojure" "-M:cljd" "flutter"] *command-line-args*)
                          {:extra-env env :in :inherit :err :inherit :out :stream})
                   state-file (io/file "target/repl-state")
                   state! (fn [s] (spit state-file (str s " " (System/currentTimeMillis) "\n")))]
               (io/make-parents state-file)
               (state! "starting")
               ;; The watcher writes REPL.lock before the app runs; a session opened then holds the compiler lock
               ;; forever. It is ready only after "REPL listening"; a hot reload is over at "Reloaded … libraries".
               (doseq [line (line-seq (io/reader (:out proc)))]
                 (println line)
                 (flush)
                 (cond
                   (str/includes? line "listening on port") (state! "ready")
                   (str/includes? line "Performing hot reload") (state! "reloading")
                   (and (str/includes? line "Reloaded ") (str/includes? line " libraries")) (state! "ready")
                   (str/includes? line "Performing hot restart") (state! "restarting")
                   ;; after `q` the watcher itself keeps running and the next key hits a closed pipe: end it all
                   (str/includes? line "Application finished.") (p/destroy-tree proc)))
               (state! "stopped")
               (System/exit (:exit (deref proc))))}

  repl-port {:doc "Port of the ClojureDart socket REPL of the running `bb dev` (empty output when none runs)"
             :task (when-let [port (repl-port)] (println port))}

  repl-eval {:doc "Evaluate ONE form in the running app (ClojureDart socket REPL of `bb dev`) and print the result:
                   bb repl-eval '(count @auto-maintenance.app/!events)' [namespace]. Waits for the prompt before sending and closes
                   only after the result and the next prompt arrived (ClojureDart#364)."
             :task (let [port (or (repl-port) (do (println "no running `bb dev` (REPL.lock)") (System/exit 1)))
                         state-file (io/file "target/repl-state")
                         [state since] (when (.exists state-file)
                                         (str/split (str/trim (slurp state-file)) (re-pattern " ")))
                         age-s (some-> since parse-long (- (System/currentTimeMillis)) - (quot 1000))
                         _ (when-not (= "ready" state)
                             (println (cond
                                        (nil? state) "REPL state unknown: start the app with `bb dev` (not clj -M:cljd flutter)"
                                        (and (= "reloading" state) (> age-s 60))
                                        (str "a hot reload started " age-s " s ago never finished (rejected?): the REPL"
                                             " is stuck until `bb dev` is restarted")
                                        :else (str "REPL not ready (" state ", " age-s " s) — try again shortly")))
                             (System/exit 2))
                         code (or (first *command-line-args*) (do (println "usage: bb repl-eval '<form>'") (System/exit 1)))
                         prompt (re-pattern "(?m)^[^\\s=>]+=> $")
                         sock (doto (java.net.Socket. "localhost" (parse-long port)) (.setSoTimeout 120000))
                         in (java.io.BufferedReader. (java.io.InputStreamReader. (.getInputStream sock) "UTF-8"))
                         out (java.io.PrintWriter. (java.io.OutputStreamWriter. (.getOutputStream sock) "UTF-8") true)
                         until-prompt (fn [] (loop [sb (StringBuilder.)]
                                               (let [c (.read in)]
                                                 (if (neg? c)
                                                   (str sb)
                                                   (let [t (str (.append sb (char c)))]
                                                     (if (re-find prompt t) t (recur sb)))))))]
                     (until-prompt)
                     (when-let [ns-name (second *command-line-args*)]
                       ;; switch first (and wait), so defs land in that namespace
                       (.println out (str "(ns " ns-name ")"))
                       (until-prompt))
                     (.println out code)
                     (println (str/trim (str/replace (until-prompt) prompt "")))
                     ;; close only now, with nothing pending: ClojureDart's single output thread dies on a write to a
                     ;; closed client socket (Broken pipe) and then no evaluation is ever acknowledged again (#364)
                     (.close sock))}

  test {:doc "Run the tests and model check in target/test-copy (no device needed)."
        ;; Test compilation can emit imports of test libraries into lib/cljd-out.
        ;; See 20261122-build-workarounds-issue.org.
        ;; Hide generated Dart on the sender so --delete also clears old output in the copy.
        :task (do (sh "mkdir -p target/test-copy")
                  (sh (str "rsync -a --delete --exclude=/build --exclude=/target --exclude=/android --exclude=/linux"
                           " --exclude=/REPL.lock --exclude=/.git --exclude=/.cpcache --exclude=/.clojuredart"
                           " --exclude=/.dart_tool --exclude=/.flutter-plugins-dependencies"
                           " --filter='hide /lib/cljd-out' --filter='hide /test/cljd-out' ./ target/test-copy/"))
                  (apply shell {:extra-env env :dir "target/test-copy"} "clojure -M:test:cljd test" *command-line-args*))}

  apk {:doc "Build a debug APK: build/app/outputs/flutter-apk/app-debug.apk"
       :depends [compile]
       :task (sh "flutter build apk --debug")}

  release {:doc "Release APK built from a clean clone of HEAD (compiled without tests — test namespaces leaking into
                 lib/cljd-out break release builds): target/release/build/app/outputs/flutter-apk/app-release.apk"
           :task (do (sh "rm -rf target/release")
                     (sh "git clone -q . target/release")
                     (shell {:extra-env env :dir "target/release"} "clojure -M:cljd compile")
                     (shell {:extra-env env :dir "target/release"}
                       ;; version code = minutes since 1970, as in CI (.github/workflows/android.yml)
                       (str "flutter build apk --release --build-number " (quot (System/currentTimeMillis) 60000)))
                     (println "APK: target/release/build/app/outputs/flutter-apk/app-release.apk"))}

  install-release {:doc "Build the release APK and install it on the connected phone (keeps the app's data)"
                   :depends [release]
                   :task (sh adb "install" "-r" "target/release/build/app/outputs/flutter-apk/app-release.apk")}

  install {:doc "Install the debug APK on the connected phone"
           :depends [apk]
           :task (sh adb "install" "-r" "build/app/outputs/flutter-apk/app-debug.apk")}

  docs {:doc "Regenerate docs/slices.md (slices + implementation status) and the model diagram (svg, png)"
        :task (load-file "scripts/docs.clj")}

  clean {:doc "Remove ClojureDart and Flutter build output"
         :task (do (sh "clojure -M:cljd clean") (sh "flutter clean"))}}}
