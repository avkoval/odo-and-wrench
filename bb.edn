;; Project tasks. Every task runs with the project's pinned Flutter first on PATH:
;; ClojureDart hangs with Flutter 3.50 (https://github.com/tensegritics/ClojureDart/issues/389),
;; so this project uses Flutter 3.47.9 from ~/sdk until that is fixed. `bb tasks` lists them.
{:min-bb-version "1.3.0"
 :tasks
 {:init
  (do
    (def home (System/getProperty "user.home"))
    (def flutter-bin (str home "/sdk/flutter-3.47.9/bin"))
    (def android-home (str home "/Android/Sdk"))
    (def env {"PATH" (str flutter-bin ":" android-home "/platform-tools:" (System/getenv "PATH"))
              "ANDROID_HOME" android-home})
    (defn sh [& args] (apply shell {:extra-env env} args)))

  doctor {:doc "flutter doctor with the pinned Flutter"
          :task (sh "flutter doctor")}

  devices {:doc "Connected devices (phone over USB / wireless adb, linux desktop)"
           :task (sh "flutter devices")}

  compile {:doc "Compile ClojureDart sources to Dart (lib/cljd-out)"
           :task (sh "clj -M:cljd compile")}

  dev {:doc "Watch, hot reload and socket REPL on a device: bb dev [-d <device-id>] (default: ask)"
       :task (apply sh "clj -M:cljd flutter" *command-line-args*)}

  test {:doc "Run the tests, including the model scenarios (no device needed)"
        :task (apply sh "clj -M:test:cljd test" *command-line-args*)}

  apk {:doc "Build a debug APK: build/app/outputs/flutter-apk/app-debug.apk"
       :depends [compile]
       :task (sh "flutter build apk --debug")}

  install {:doc "Install the debug APK on the connected phone"
           :depends [apk]
           :task (sh "adb install -r build/app/outputs/flutter-apk/app-debug.apk")}

  clean {:doc "Remove ClojureDart and Flutter build output"
         :task (do (sh "clj -M:cljd clean") (sh "flutter clean"))}}}
