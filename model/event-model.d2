title: |md
  # auto-maintenance: one car, left to right
  24 slices — model/event-model.yaml is the full model
| {near: top-center}

model: {
  label: ""
  grid-rows: 5
  grid-columns: 11
  grid-gap: 30
  style.fill: "#F7F7F7"

  l0: "Owner\n(screens)" {shape: text; style.font-size: 20}
  s_garage: "Add car\nphoto of VIN" {style.fill: "#FFFFFF"; shape: page}
  s_sched: "Schedule\npick template (+ LPG), edit" {style.fill: "#FFFFFF"; shape: page}
  s_cap: "Odometer\nphoto → confirm km" {style.fill: "#FFFFFF"; shape: page}
  s_issue: "To fix\nadd / withdraw" {style.fill: "#FFFFFF"; shape: page}
  s_log: "Log entry\njobs + fixes + cost" {style.fill: "#FFFFFF"; shape: page}
  s_car: "Car\nwhat is due" {style.fill: "#FFFFFF"; shape: page}
  s_share: "Share / Copy\nlist for the mechanic" {style.fill: "#FFFFFF"; shape: page}
  s_diary: "Diary / Costs\nhistory, per year" {style.fill: "#FFFFFF"; shape: page}
  s_settings: "Settings\nlanguage, reminders" {style.fill: "#FFFFFF"; shape: page}
  s_notif: "Notification\n'oil in 600 km'" {style.fill: "#FFFFFF"; shape: page}

  l1: "External" {shape: text; style.font-size: 20}
  x_vin: "VIN decoder\nJF1…8G… → Subaru 2008" {style.fill: "#FFF59D"}
  x_tpl: "Template catalogue\n(app data)" {style.fill: "#FFF59D"}
  x_ocr: "Camera +\nML Kit text recognition" {style.fill: "#FFF59D"}
  g1: "" {style.opacity: 0}
  g2: "" {style.opacity: 0}
  g3: "" {style.opacity: 0}
  x_share: "Android share sheet\n/ clipboard" {style.fill: "#FFF59D"}
  g4: "" {style.opacity: 0}
  g5: "" {style.opacity: 0}
  x_tick: "Scheduled job\nat notify_at" {style.fill: "#FFF59D"}

  l2: "Commands /\nRead models" {shape: text; style.font-size: 20}
  c_reg: "car/register" {style.fill: "#A7C7E7"}
  c_def: "schedule/apply-template\ndefine / change / retire" {style.fill: "#A7C7E7"}
  c_odo: "odometer/record\n(km + recognized_km)" {style.fill: "#A7C7E7"}
  c_issue: "issue/report\nissue/withdraw" {style.fill: "#A7C7E7"}
  c_log: "maintenance/log\n(items, fixes, cost)" {style.fill: "#A7C7E7"}
  rm_due: "due-list, mileage\ngarage" {style.fill: "#C5E8A0"}
  rm_issues: "open-issues\n(+ message)" {style.fill: "#C5E8A0"}
  rm_diary: "diary\ncosts-by-year" {style.fill: "#C5E8A0"}
  c_set: "settings/choose-language\nconfigure-reminders" {style.fill: "#A7C7E7"}
  rm_rem: "reminders-to-send\n→ reminder/send" {style.fill: "#C5E8A0"}

  l3: "car stream\n(events)" {shape: text; style.font-size: 20}
  e_reg: "car/registered\nVIN, plate, fuels" {style.fill: "#F5A65B"}
  e_def: "schedule/item-defined" {style.fill: "#F5A65B"}
  e_odo: "odometer/recorded\nO-0001 129 400" {style.fill: "#F5A65B"}
  e_issue: "issue/reported\nI-0001" {style.fill: "#F5A65B"}
  e_log: "maintenance/performed\nM-0010 fixes I-0001" {style.fill: "#F5A65B"}
  g6: "" {style.opacity: 0}
  g7: "" {style.opacity: 0}
  g8: "" {style.opacity: 0}
  e_set: "settings stream:\nlanguage-chosen\nreminders-configured" {style.fill: "#F5A65B"}
  e_rem: "reminder/sent\nengine-oil soon" {style.fill: "#F5A65B"}

  l4: "corrections" {shape: text; style.font-size: 20}
  g10: "" {style.opacity: 0}
  e_chg: "schedule/item-changed\nitem-retired" {style.fill: "#F5A65B"}
  e_corr: "odometer/corrected\n(reason)" {style.fill: "#F5A65B"}
  e_wd: "issue/withdrawn\n(reason)" {style.fill: "#F5A65B"}
  e_void: "maintenance/voided\n(reopens its fixes)" {style.fill: "#F5A65B"}
  g11: "" {style.opacity: 0}
  g12: "" {style.opacity: 0}
  g13: "" {style.opacity: 0}
  g14: "" {style.opacity: 0}
  g15: "" {style.opacity: 0}
}

model.s_garage -> model.x_vin
model.x_vin -> model.c_reg: decoded
model.c_reg -> model.e_reg
model.x_tpl -> model.s_sched: suggestions
model.s_sched -> model.c_def
model.c_def -> model.e_def
model.s_cap -> model.x_ocr
model.x_ocr -> model.c_odo: km guess, confirmed
model.c_odo -> model.e_odo
model.s_issue -> model.c_issue
model.c_issue -> model.e_issue
model.s_log -> model.c_log
model.c_log -> model.e_log
model.e_odo -> model.rm_due
model.e_log -> model.rm_due
model.e_issue -> model.rm_issues
model.e_log -> model.rm_issues: closes
model.rm_due -> model.s_car
model.rm_issues -> model.s_share
model.s_share -> model.x_share
model.e_log -> model.rm_diary
model.rm_diary -> model.s_diary
model.s_settings -> model.c_set
model.c_set -> model.e_set
model.x_tick -> model.rm_rem
model.rm_rem -> model.e_rem
model.e_rem -> model.s_notif
